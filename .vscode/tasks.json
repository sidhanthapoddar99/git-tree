{
    "version": "2.0.0",
    "presentation": {
        "reveal": "always",
        "focus": false,
        "echo": true,
        "showReuseMessage": false,
        "panel": "shared"
    },
    "tasks": [
        {
            "type": "npm",
            "script": "compile",
            "label": "Compile"
        },
        {
            "type": "npm",
            "script": "compile-src",
            "label": "Compile (Back-End Only)"
        },
        {
            "type": "npm",
            "script": "compile-web",
            "label": "Compile (Front-End Only)"
        },
        {
            "type": "npm",
            "script": "compile-web-debug",
            "label": "Compile (Front-End Only) - Debug"
        },
        {
            "type": "npm",
            "script": "lint",
            "label": "Lint"
        },
        {
            "type": "npm",
            "script": "package",
            "label": "Package VSIX"
        },
        {
            "type": "npm",
            "script": "package-and-install",
            "label": "Package VSIX (Install on Completion)"
        },
        {
            "type": "npm",
            "script": "test",
            "label": "Run Unit Tests"
        },
        {
            "type": "npm",
            "script": "test-and-report-coverage",
            "label": "Run Unit Tests (Report Code Coverage)"
        },
        {
            // An unminified build, so the webview can be debugged with Developer: Open Webview Developer Tools
            "label": "Build (Debug)",
            "dependsOrder": "sequence",
            "dependsOn": ["Compile (Back-End Only)", "Compile (Front-End Only) - Debug"],
            "problemMatcher": []
        },
        {
            "label": "Build Demo Repository (If Missing)",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/make-demo-repo.sh --if-missing",
            "problemMatcher": []
        },
        {
            "label": "Rebuild Demo Repository",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/make-demo-repo.sh --force",
            "problemMatcher": []
        },
        {
            "label": "Prepare Dev Host",
            "dependsOn": ["Build (Debug)", "Build Demo Repository (If Missing)"],
            "problemMatcher": []
        }
    ]
}
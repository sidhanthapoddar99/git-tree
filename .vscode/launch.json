{
	"version": "0.2.0",
	"configurations": [
		{
			// The usual way to try a change: builds Git Tree (unminified), builds the demo repository if it's
			// missing, and opens it in an Extension Development Host. Other extensions are disabled, so an
			// installed copy of Git Tree doesn't get in the way.
			"name": "Run Extension (demo repo)",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--disable-extensions",
				"${workspaceFolder}/dev-workspace/demo.code-workspace"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"preLaunchTask": "Prepare Dev Host"
		},
		{
			// Opens an empty window, for trying Git Tree on a folder of your own.
			"name": "Run Extension (empty window)",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"preLaunchTask": "Build (Debug)"
		}
	]
}
